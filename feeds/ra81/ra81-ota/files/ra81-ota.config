config ota 'main'
	# GitHub "owner/name" to update from; empty: the repository that built
	# the running image (OTA_REPO in /etc/ra81-nss/build-info)
	option repo ''
	# usign public key the release's sha256sums must be signed with
	option pubkey '/etc/ra81-nss/release.pub'
	# 'stable': releases not marked as pre-release; 'testing': all of them
	option channel 'stable'
	option allow_unsigned '0'
	# seconds a newly installed firmware has to be kept before on_timeout:
	# 'confirm' (if the LAN is up and check_host/the gateway answers) or
	# 'rollback'
	option trial_timeout '600'
	option on_timeout 'confirm'
	option check_host ''
