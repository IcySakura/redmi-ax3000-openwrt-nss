# Xiaomi Redmi AX3000 (RA81) with NSS offload - diffconfig, expanded by "make defconfig".
# Package selections beyond this base belong in profiles/*.packages.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_xiaomi_redmi-ax3000=y
# Also an initramfs FIT (RAM boot via U-Boot TFTP over UART, no flashing)
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# NSS runtime: arms the firmware and pulls in every kmod the plane needs
CONFIG_PACKAGE_nss-tools-dwmac=y
CONFIG_PACKAGE_nss-firmware=y
# 12.2-156: the firmware the 256 MB tuning in the upstream tree was measured on
CONFIG_NSS_FIRMWARE_VERSION_12_2=y
CONFIG_NSS_MEM_PROFILE_LOW=y

CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y

# PPPoE (ECM only accelerates PPPoE with this manager present)
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y

# ath11k with the NSS patches, 256 MiB profiles
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_ATH11K_MEM_PROFILE_256M=y
CONFIG_ATH11K_NSS_MEM_PROFILE_256M=y
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y

# Web UI
CONFIG_PACKAGE_luci=y
