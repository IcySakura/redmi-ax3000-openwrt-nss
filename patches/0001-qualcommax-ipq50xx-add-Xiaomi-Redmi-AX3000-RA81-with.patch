diff --git a/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/xiaomi-dualboot.sh b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/xiaomi-dualboot.sh
new file mode 100644
index 0000000..2515ecc
--- /dev/null
+++ b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/xiaomi-dualboot.sh
@@ -0,0 +1,31 @@
+. /lib/functions/xiaomi-dualboot.sh
+
+# Flash the slot that is not running, then let U-Boot try it once. The
+# running system stays untouched as the fallback.
+xiaomi_dualboot_do_upgrade() {
+	local slot
+
+	slot=$(xiaomi_dualboot_slot) || {
+		v "Unable to determine the running slot from /proc/cmdline"
+		nand_do_upgrade_failed
+	}
+
+	if [ "$slot" = 0 ]; then
+		CI_UBIPART="rootfs_1"
+	else
+		CI_UBIPART="rootfs"
+	fi
+	v "Running from slot $slot, flashing $CI_UBIPART"
+
+	nand_do_flash_file "$1" || nand_do_upgrade_failed
+
+	# Only switch slots once the new one has been written completely.
+	xiaomi_dualboot_setenv \
+		"flag_try_sys1_failed 0" \
+		"flag_try_sys2_failed 0" \
+		"flag_last_success $slot" \
+		"flag_boot_success" \
+		"flag_ota_reboot 1" || nand_do_upgrade_failed
+
+	nand_do_upgrade_success
+}
