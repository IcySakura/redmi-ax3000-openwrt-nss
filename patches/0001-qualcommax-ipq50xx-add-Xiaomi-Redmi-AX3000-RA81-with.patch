diff --git a/target/linux/qualcommax/ipq50xx/base-files/lib/functions/xiaomi-dualboot.sh b/target/linux/qualcommax/ipq50xx/base-files/lib/functions/xiaomi-dualboot.sh
new file mode 100644
index 0000000..6f21127
--- /dev/null
+++ b/target/linux/qualcommax/ipq50xx/base-files/lib/functions/xiaomi-dualboot.sh
@@ -0,0 +1,89 @@
+# Helpers for the dual-boot scheme of the Xiaomi "bootmiwifi" U-Boot,
+# which boots the "kernel" UBI volume of either the "rootfs" (slot 0) or
+# the "rootfs_1" (slot 1) MTD partition and passes ubi.mtd=<partition>.
+#
+# Slot selection, as implemented by the Redmi AX3000 (RA81) U-Boot:
+#  - flag_ota_reboot=1: boot slot (1 - flag_last_success), unless
+#    flag_boot_success exists and is 0, in which case the previous attempt
+#    failed: roll back to flag_last_success and clear flag_ota_reboot.
+#  - otherwise: boot flag_last_success, or the other slot when its
+#    flag_try_sys<1|2>_failed is set.
+#  - An image that cannot be booted sets flag_try_sys<N>_failed=1, clears
+#    flag_ota_reboot and resets the board.
+#
+# U-Boot never writes flag_boot_success, so a system booted for a trial
+# arms it (0) early in preinit and confirms it (1) once boot has completed.
+
+. /lib/functions.sh
+
+XIAOMI_DUALBOOT_FW_ENV=/tmp/xiaomi-dualboot.fw_env.config
+
+xiaomi_dualboot_slot() {
+	case "$(sed -n 's/.*ubi\.mtd=\([^ ]*\).*/\1/p' /proc/cmdline)" in
+	rootfs)
+		echo 0
+		;;
+	rootfs_1)
+		echo 1
+		;;
+	*)
+		return 1
+		;;
+	esac
+}
+
+# Use a private fw_env config so that this also works in preinit and in
+# the sysupgrade ramfs, before/without /etc/fw_env.config.
+xiaomi_dualboot_fw_env() {
+	local mtdidx
+
+	[ -s "$XIAOMI_DUALBOOT_FW_ENV" ] && return 0
+
+	mtdidx=$(find_mtd_index "0:appsblenv")
+	[ -n "$mtdidx" ] || return 1
+
+	mkdir -p /var/lock
+	echo "/dev/mtd$mtdidx 0x0 0x10000 0x20000" > "$XIAOMI_DUALBOOT_FW_ENV"
+}
+
+xiaomi_dualboot_getenv() {
+	xiaomi_dualboot_fw_env || return 1
+	fw_printenv -c "$XIAOMI_DUALBOOT_FW_ENV" -n "$1" 2>/dev/null
+}
+
+# Every argument is one "name [value]" line; a bare name deletes the variable.
+xiaomi_dualboot_setenv() {
+	local script=/tmp/xiaomi-dualboot.fw_setenv
+
+	xiaomi_dualboot_fw_env || return 1
+	printf '%s\n' "$@" > "$script"
+	fw_setenv -c "$XIAOMI_DUALBOOT_FW_ENV" -s "$script"
+}
+
+# Called from preinit: if U-Boot is trying this slot after an upgrade,
+# make it roll back on the next boot unless this one completes.
+xiaomi_dualboot_arm() {
+	[ "$(xiaomi_dualboot_getenv flag_ota_reboot)" = 1 ] || return 0
+	[ "$(xiaomi_dualboot_getenv flag_boot_success)" = 0 ] && return 0
+
+	xiaomi_dualboot_setenv "flag_boot_success 0"
+}
+
+# Called once boot has completed: make the running slot the default.
+xiaomi_dualboot_confirm() {
+	local slot
+
+	slot=$(xiaomi_dualboot_slot) || return 1
+
+	[ "$(xiaomi_dualboot_getenv flag_ota_reboot)" != 1 ] && \
+	[ "$(xiaomi_dualboot_getenv flag_last_success)" = "$slot" ] && \
+	[ "$(xiaomi_dualboot_getenv flag_boot_success)" = 1 ] && \
+		return 0
+
+	xiaomi_dualboot_setenv \
+		"flag_last_success $slot" \
+		"flag_ota_reboot 0" \
+		"flag_boot_success 1" \
+		"flag_try_sys1_failed 0" \
+		"flag_try_sys2_failed 0"
+}
diff --git a/target/linux/qualcommax/ipq50xx/base-files/lib/preinit/81_xiaomi_dualboot b/target/linux/qualcommax/ipq50xx/base-files/lib/preinit/81_xiaomi_dualboot
new file mode 100644
